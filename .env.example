# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Your own Neon branch (Neon console > your project > Branches > dev-<yourname> > Connect).
# Use the POOLED connection string. It must end with ?sslmode=require
DATABASE_URL=

# Any long random string (run: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email for verification links, password resets and 2FA codes (resend.com). # optional
# Without it nothing is sent (links print in the dev console) and sign-in does not require a verified email.
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client). # optional
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
# optional
GOOGLE_CLIENT_SECRET=

# Long random string used to sign QR tokens (Chris shares the team value)
QR_SECRET=
DEMO_PASSWORD=

# Google Maps key, restricted to our domains (Lethu shares it) # optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
